{
    "name": "orx-parallel-wasm",
    "version": "1.0.0",
    "type": "module",
    "files": [
        "dist",
        "src",
        "pkg"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./worker": "./dist/worker.js",
        "./vite": "./dist/vite.js",
        "./build": "./dist/build.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "npm run build && node --test test/client.test.mjs test/build.test.mjs test/vite.test.mjs",
        "wasm:build": "node src/build.js build",
        "wasm:prepare": "node src/build.js prepare",
        "prepare": "npm run build",
        "postbuild": "node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); fs.cpSync('src/vite.js','dist/vite.js'); fs.cpSync('src/build.js','dist/build.js');\"",
        "prepublishOnly": "npm run prepare"
    },
    "devDependencies": {
        "typescript": "^5.8.3"
    },
    "description": "Build and integrate orx-parallel Rust->WASM bindings with Vite and worker runtimes.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/orxfun/orx-parallel-wasm.git"
    }
}